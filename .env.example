# TiDB Cloud Serverless Connection
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=RAG
TIDB_SSL_CA=isrgrootx1.pem

# OpenAI-Compatible Endpoint Configuration (Default: Kenari AI)
OPENAI_BASE_URL=https://kenari.id/v1
OPENAI_API_KEY=your-openai-or-kenari-api-key
OPENAI_MODEL=meta-llama/Llama-3-8b
